# ── TrendForge configuration ────────────────────────────────────
# EVERY key below is OPTIONAL. With none set, the app runs end-to-end
# on rich "smart mock" data. Add a key to switch that capability to live.

# ── Server ──────────────────────────────────────────────────────
TF_HOST=0.0.0.0
TF_PORT=5050
TF_DEBUG=true
TF_SECRET_KEY=change-me

# ── LLM (scripts, analysis, outlines) ───────────────────────────
# Provider auto-detects from whichever key is present.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Groq is a free OpenAI-compatible alternative:
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Trend / social intelligence ─────────────────────────────────
# LunarCrush: social listening across X, TikTok, YouTube, Reddit.
LUNARCRUSH_API_KEY=
YOUTUBE_API_KEY=

# ── Video rendering ─────────────────────────────────────────────
VIDEO_PROVIDER=auto
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=stability-ai/stable-video-diffusion
RUNWAY_API_KEY=
PIKA_API_KEY=

# ── Music / song generation ─────────────────────────────────────
MUSIC_PROVIDER=auto
SUNO_API_KEY=

# ── Voiceover / TTS ─────────────────────────────────────────────
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
